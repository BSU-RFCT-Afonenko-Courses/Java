   with patch.dict(os.environ,{'PL_CONTAINMENT':'official'}),patch.object(grader,'_verify_landlock_helper'),patch.object(grader,'_run',side_effect=official_version):
    for rid in ('java25-gradle-junit-v1','java25-junit-v1','java25-mutation-v1'):
     with self.subTest(runtime=rid):self.assertEqual(grader.preflight(rid,value)[2],output.strip())
+   fixture=native.fixtures.JUnitJob();fixture.setUp()
+   try:
+    (fixture.job/'tests/grading-job.json').write_text(json.dumps(fixture.cfg))
+    (fixture.job/'student/Student.java').unlink()
+    read_text=Path.read_text
+    for kind in ('runner','bundle','shared'):
+     with self.subTest(stale_pin=kind):
+      changed=copy.deepcopy(value);profile=changed['profiles']['java25-junit-v1']
+      if kind=='runner':profile['runnerSha256']='0'*64
+      else:
+       pins=profile['files' if kind=='bundle' else 'sharedFiles'];pins[next(iter(pins))]='0'*64
+      def image_registry(path,*args,**kwargs):
+       if path==grader.PLATFORM/'runtime-profiles.json':return json.dumps(changed)
+       return read_text(path,*args,**kwargs)
+      # Synthetic admission: проверяем routing/evidence, не image/role qualification.
+      with patch.object(grader,'_protect_input_identity'),patch.object(grader,'_admit_java_job',return_value={}),patch.object(Path,'read_text',image_registry):
+       result=grader.grade(fixture.job)
+       self.assertEqual(result['classification'],'unsafe-submission')
+       self.assertEqual(result['executionEvidence']['dependencyHashes'],{**profile['files'],**profile['sharedFiles'],'runner/grade.py':profile['runnerSha256']})
+       with self.assertRaisesRegex(grader.GraderError,'checksum mismatch'):grader.grade(fixture.job,registry=changed)
+      with self.assertRaisesRegex(grader.GraderError,'checksum mismatch'):grader.preflight('java25-junit-v1',changed)
+      with patch.dict(os.environ,{'PL_CONTAINMENT':'host'}),patch.object(Path,'read_text',image_registry):
+       with self.assertRaisesRegex(grader.GraderError,'checksum mismatch'):grader.grade(fixture.job)
+   finally:fixture.doCleanups()
   with patch.dict(os.environ,{'PL_CONTAINMENT':'host'}),patch.object(grader,'_run',side_effect=[(0,output,None),(0,'javac 24',None)]) as run:
